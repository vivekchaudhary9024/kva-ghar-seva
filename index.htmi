
<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KVA Ghar Seva | Premium Home Services</title>
    <meta name="description" content="KVA Ghar Seva - Halena में घर की सेवाओं के लिए संपर्क और बुकिंग करें।">

    <!-- Google Fonts: Correct URLs -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome: Correct stylesheet -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>
        :root {
            --navy: #0a192f;
            --gold: #d4af37;
            --cream: #fcf8e3;
            --white: #ffffff;
            --grey: #f4f6f9;
            --text: #232b38;
            --shadow: 0 15px 35px rgba(10,25,47,.10);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--grey);
            color: var(--text);
            line-height: 1.7;
            overflow-x: hidden;
        }

        h1, h2, h3, h4 {
            font-family: 'Cinzel', serif;
        }

        a { text-decoration: none; }

        .container {
            width: min(1150px, 90%);
            margin: auto;
        }

        /* HEADER */
        header {
            background: var(--navy);
            border-bottom: 3px solid var(--gold);
            padding: 17px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .brand h1 {
            color: var(--white);
            font-size: 1.55rem;
            line-height: 1.3;
        }

        .brand h1 span { color: var(--gold); }

        .brand p {
            color: #a8b2d1;
            font-size: .68rem;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 13px 23px;
            background: var(--gold);
            color: var(--navy);
            border: 1px solid var(--gold);
            border-radius: 4px;
            font: 700 .9rem 'Montserrat', sans-serif;
            cursor: pointer;
            transition: .3s;
        }

        .btn:hover {
            background: transparent;
            color: var(--gold);
            transform: translateY(-2px);
        }

        /* HERO */
        .hero {
            background:
                linear-gradient(rgba(10,25,47,.85), rgba(10,25,47,.92)),
                url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85');
            background-size: cover;
            background-position: center;
            color: var(--white);
            text-align: center;
            padding: 125px 20px 145px;
        }

        .eyebrow {
            color: var(--gold);
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: .8rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .hero h2 {
            font-size: clamp(2rem, 5vw, 3.8rem);
            line-height: 1.3;
            margin-bottom: 22px;
        }

        .hero h2 span { color: var(--gold); }

        .hero p {
            max-width: 760px;
            margin: 0 auto 35px;
            color: #d4daea;
            font-size: 1.08rem;
        }

        .outline-btn {
            display: inline-flex;
            gap: 10px;
            align-items: center;
            padding: 15px 28px;
            border: 2px solid var(--gold);
            color: var(--gold);
            font-weight: 700;
            transition: .3s;
        }

        .outline-btn:hover {
            background: var(--gold);
            color: var(--navy);
        }

        /* TRUST CARDS */
        .trust-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
            margin-top: -45px;
            position: relative;
            z-index: 2;
            margin-bottom: 85px;
        }

        .trust-card {
            background: var(--navy);
            color: var(--white);
            padding: 32px 20px;
            text-align: center;
            border: 1px solid rgba(212,175,55,.4);
            box-shadow: var(--shadow);
        }

        .trust-card i {
            color: var(--gold);
            font-size: 2rem;
            margin-bottom: 12px;
        }

        .trust-card h3 { font-size: 1.1rem; }

        .trust-card p {
            color: #c5cce0;
            font-size: .9rem;
            margin-top: 7px;
        }

        /* SERVICES */
        section { scroll-margin-top: 100px; }

        .section {
            padding: 30px 0 85px;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 42px;
        }

        .section-heading h2 {
            color: var(--navy);
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            margin-bottom: 10px;
        }

        .section-heading h2 span { color: var(--gold); }

        .section-heading p {
            color: #647084;
            max-width: 650px;
            margin: auto;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 28px;
        }

        .service-card {
            background: var(--white);
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            transition: .3s;
            border-bottom: 3px solid transparent;
        }

        .service-card:hover {
            transform: translateY(-7px);
            border-color: var(--gold);
        }

        .service-image {
            height: 190px;
            background: var(--navy);
            color: var(--gold);
            display: grid;
            place-items: center;
            font-size: 3.6rem;
            border-bottom: 3px solid var(--gold);
        }

        .service-content {
            padding: 25px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .service-content h3 {
            color: var(--navy);
            font-size: 1.2rem;
            margin-bottom: 10px;
        }

        .service-content p {
            color: #647084;
            font-size: .93rem;
            margin-bottom: 22px;
            flex: 1;
        }

        .service-link {
            display: block;
            text-align: center;
            padding: 12px;
            color: var(--gold);
            background: var(--navy);
            font-weight: 700;
            transition: .3s;
        }

        .service-link:hover {
            background: var(--gold);
            color: var(--navy);
        }

        /* BOOKING */
        .booking {
            background: var(--navy);
            color: var(--white);
            padding: 80px 20px;
            border-top: 3px solid var(--gold);
        }

        .booking .section-heading h2 { color: var(--white); }

        .booking .section-heading p { color: #c5cce0; }

        .booking-form {
            max-width: 700px;
            margin: auto;
            padding: 30px;
            background: #10213c;
            border: 1px solid rgba(212,175,55,.45);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-bottom: 18px;
        }

        .field.full { grid-column: 1 / -1; }

        .field label {
            font-size: .9rem;
            color: var(--cream);
        }

        .field input,
        .field select,
        .field textarea {
            width: 100%;
            padding: 13px;
            font: 400 .95rem 'Montserrat', sans-serif;
            border: 1px solid #526078;
            border-radius: 3px;
            background: var(--white);
            color: var(--text);
        }

        .field textarea {
            resize: vertical;
            min-height: 100px;
        }

        .booking-form .btn { width: 100%; }

        .form-note {
            margin-top: 14px;
            color: #c5cce0;
            font-size: .8rem;
            text-align: center;
        }

        /* FOOTER */
        footer {
            background: #06101f;
            color: #c5cce0;
            padding: 35px 20px;
            text-align: center;
        }

        footer h3 {
            color: var(--gold);
            margin-bottom: 8px;
        }

        footer p { font-size: .88rem; }

        .footer-links {
            margin-top: 14px;
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .footer-links a { color: var(--gold); }

        /* WHATSAPP FLOAT */
        .whatsapp-float {
            position: fixed;
            right: 22px;
            bottom: 22px;
            width: 58px;
            height: 58px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: #25d366;
            color: white;
            font-size: 30px;
            box-shadow: 0 5px 18px rgba(0,0,0,.25);
            z-index: 1100;
        }

        .whatsapp-float:hover { transform: scale(1.08); }

        /* MOBILE RESPONSIVE */
        @media (max-width: 800px) {
            .trust-grid { grid-template-columns: 1fr; }
            .services-grid { grid-template-columns: repeat(2, 1fr); }
            .hero { padding: 95px 20px 115px; }
        }

        @media (max-width: 560px) {
            header { padding: 14px 5%; }
            .brand h1 { font-size: 1.15rem; }
            .brand p { font-size: .55rem; letter-spacing: 1px; }
            header .btn { padding: 10px; font-size: .75rem; }
            .services-grid { grid-template-columns: 1fr; }
            .form-grid { grid-template-columns: 1fr; }
            .field.full { grid-column: auto; }
            .booking-form { padding: 20px 15px; }
            .hero p { font-size: .96rem; }
            .section { padding-bottom: 60px; }
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header>
        <a class="brand" href="#home" aria-label="KVA Ghar Seva Home">
            <h1>KVA <span>Ghar Seva</span></h1>
            <p>Premium Home Services · Halena</p>
        </a>

        <a class="btn" href="#booking">
            <i class="fa-solid fa-calendar-check"></i>
            Book Now
        </a>
    </header>

    <!-- HERO -->
    <main>
        <section class="hero" id="home">
            <div class="eyebrow">Welcome to KVA Ghar Seva</div>

            <h2>Your Home, <span>Our Care</span></h2>

            <p>
                आपके घर की जरूरतों के लिए एक भरोसेमंद संपर्क।
                आसान बुकिंग, सुविधाजनक सेवा और आपकी जरूरतों पर खास ध्यान।
            </p>

            <a class="outline-btn" href="#services">
                Explore Services
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </section>

        <!-- TRUST -->
        <div class="container">
            <div class="trust-grid">
                <article class="trust-card">
                    <i class="fa-solid fa-house-chimney"></i>
                    <h3>Home Convenience</h3>
                    <p>घर की जरूरतों के लिए आसान संपर्क।</p>
                </article>

                <article class="trust-card">
                    <i class="fa-solid fa-calendar-check"></i>
                    <h3>Easy Booking</h3>
                    <p>अपनी जरूरत बताएं और बुकिंग का अनुरोध भेजें।</p>
                </article>

                <article class="trust-card">
                    <i class="fa-solid fa-headset"></i>
                    <h3>Direct Contact</h3>
                    <p>सेवा की जानकारी और उपलब्धता के लिए संपर्क करें।</p>
                </article>
            </div>
        </div>

        <!-- SERVICES -->
        <section class="section" id="services">
            <div class="container">
                <div class="section-heading">
                    <h2>Our Premium <span>Services</span></h2>
                    <p>
                        अपनी जरूरत के अनुसार सेवा चुनें।
                        उपलब्ध सेवाओं और कीमतों की पुष्टि संपर्क के समय करें।
                    </p>
                </div>

                <div class="services-grid">

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-broom"></i>
                        </div>
                        <div class="service-content">
                            <h3>Home Cleaning</h3>
                            <p>घर की सफाई से जुड़ी जरूरतों के लिए बुकिंग का अनुरोध करें।</p>
                            <a class="service-link" href="#booking" data-service="Home Cleaning">
                                Book Service
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-screwdriver-wrench"></i>
                        </div>
                        <div class="service-content">
                            <h3>Home Repairs</h3>
                            <p>घर की मरम्मत से संबंधित जरूरत के लिए संपर्क करें।</p>
                            <a class="service-link" href="#booking" data-service="Home Repairs">
                                Book Service
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-faucet"></i>
                        </div>
                        <div class="service-content">
                            <h3>Plumbing</h3>
                            <p>पाइप, नल और अन्य प्लंबिंग जरूरतों के लिए अनुरोध भेजें।</p>
                            <a class="service-link" href="#booking" data-service="Plumbing">
                                Book Service
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-bolt"></i>
                        </div>
                        <div class="service-content">
                            <h3>Electrical Work</h3>
                            <p>बिजली से जुड़े काम के लिए अपनी जरूरत बताएं।</p>
                            <a class="service-link" href="#booking" data-service="Electrical Work">
                                Book Service
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-snowflake"></i>
                        </div>
                        <div class="service-content">
                            <h3>AC Services</h3>
                            <p>AC सर्विसिंग या मरम्मत की उपलब्धता पूछें।</p>
                            <a class="service-link" href="#booking" data-service="AC Services">
                                Book Service
                            </a>
                        </div>
                    </article>

                    <article class="service-card">
                        <div class="service-image">
                            <i class="fa-solid fa-ellipsis"></i>
                        </div>
                        <div class="service-content">
                            <h3>Other Services</h3>
                            <p>कोई दूसरी घरेलू जरूरत है? उसका विवरण भेजें।</p>
                            <a class="service-link" href="#booking" data-service="Other Services">
                                Contact Us
                            </a>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- BOOKING FORM -->
        <section class="booking" id="booking">
            <div class="container">
                <div class="section-heading">
                    <h2>Book Your <span>Service</span></h2>
                    <p>
                        नीचे जानकारी भरें। आपका अनुरोध WhatsApp पर भेजने
                        के लिए संदेश तैयार किया जाएगा।
                    </p>
                </div>

                <form class="booking-form" id="bookingForm">
                    <div class="form-grid">

                        <div class="field">
                            <label for="customerName">आपका नाम *</label>
                            <input id="customerName" name="name"
                                   type="text" required maxlength="80"
                                   placeholder="अपना नाम लिखें">
                        </div>

                        <div class="field">
                            <label for="customerPhone">मोबाइल नंबर *</label>
                            <input id="customerPhone" name="phone"
                                   type="tel" required
                                   inputmode="numeric"
                                   pattern="[0-9]{10}"
                                   maxlength="10"
                                   placeholder="10 अंकों का नंबर">
                        </div>

                        <div class="field full">
                            <label for="service">सेवा चुनें *</label>
                            <select id="service" name="service" required>
                                <option value="">सेवा चुनें</option>
                                <option>Home Cleaning</option>
                                <option>Home Repairs</option>
                                <option>Plumbing</option>
                                <option>Electrical Work</option>
                                <option>AC Services</option>
                                <option>Other Services</option>
                            </select>
                        </div>

                        <div class="field full">
                            <label for="address">पता / क्षेत्र *</label>
                            <input id="address" name="address"
                                   type="text" required maxlength="200"
                                   placeholder="अपना क्षेत्र और पता लिखें">
                        </div>

                        <div class="field full">
                            <label for="details">काम की जानकारी</label>
                            <textarea id="details" name="details"
                                      maxlength="1000"
                                      placeholder="आपको किस तरह की सेवा चाहिए?"></textarea>
                        </div>

                    </div>

                    <button class="btn" type="submit">
                        <i class="fa-brands fa-whatsapp"></i>
                        Send Booking Request
                    </button>

                    <p class="form-note">
                        यह फॉर्म WhatsApp संदेश तैयार करता है।
                        बुकिंग की पुष्टि सेवा प्रदाता से संपर्क के बाद होगी।
                    </p>
                </form>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer>
        <h3>KVA Ghar Seva</h3>
        <p>Premium Home Services · Halena</p>
        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#booking">Book Service</a>
        </div>
        <p style="margin-top:18px;">
            &copy; <span id="year"></span> KVA Ghar Seva. All rights reserved.
        </p>
    </footer>

    <!-- FLOATING WHATSAPP -->
    <a class="whatsapp-float"
       id="whatsappFloat"
       href="#booking"
       aria-label="WhatsApp पर संपर्क करें"
       title="WhatsApp पर संपर्क करें">
        <i class="fa-brands fa-whatsapp"></i>
    </a>

    <script>
        /*
          IMPORTANT:
          नीचे दिए नंबर को अपने असली WhatsApp नंबर से बदलें।
          भारत का नंबर उदाहरण: 919876543210
          +, spaces या hyphens न लगाएं।
        */
        const WHATSAPP_NUMBER = "91XXXXXXXXXX";

        document.getElementById("year").textContent =
            new Date().getFullYear();

        // Service card पर क्लिक करने पर वही सेवा चुनें।
        document.querySelectorAll("[data-service]").forEach(function (link) {
            link.addEventListener("click", function () {
                document.getElementById("service").value =
                    link.dataset.service;
            });
        });

        // Floating WhatsApp button
        document.getElementById("whatsappFloat").addEventListener(
            "click", function (event) {
                event.preventDefault();

                if (!/^91[0-9]{10}$/.test(WHATSAPP_NUMBER)) {
                    document.getElementById("booking").scrollIntoView({
                        behavior: "smooth"
                    });
                    alert("पहले कोड में अपना सही WhatsApp नंबर सेट करें।");
                    return;
                }

                const message =
                    "नमस्ते KVA Ghar Seva, मुझे आपकी सेवा की जानकारी चाहिए।";

                window.open(
                    "https://wa.me/" + WHATSAPP_NUMBER +
                    "?text=" + encodeURIComponent(message),
                    "_blank",
                    "noopener,noreferrer"
                );
            }
        );

        // Booking request
        document.getElementById("bookingForm").addEventListener(
            "submit", function (event) {
                event.preventDefault();

                if (!/^91[0-9]{10}$/.test(WHATSAPP_NUMBER)) {
                    alert("कृपया पहले JavaScript में अपना WhatsApp नंबर डालें।");
                    return;
                }

                const name = document.getElementById("customerName").value.trim();
                const phone = document.getElementById("customerPhone").value.trim();
                const service = document.getElementById("service").value;
                const address = document.getElementById("address").value.trim();
                const details = document.getElementById("details").value.trim();

                const message = [
                    "नमस्ते KVA Ghar Seva!",
                    "",
                    "मुझे सेवा बुक करनी है।",
                    "नाम: " + name,
                    "मोबाइल: " + phone,
                    "सेवा: " + service,
                    "पता: " + address,
                    "काम की जानकारी: " + (details || "नहीं दी गई")
                ].join("\n");

                window.open(
                    "https://wa.me/" + WHATSAPP_NUMBER +
                    "?text=" + encodeURIComponent(message),
                    "_blank",
                    "noopener,noreferrer"
                );
            }
        );
    </script>

</body>
</html>
