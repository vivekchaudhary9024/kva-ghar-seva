<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KVA Ghar Seva - Halena's Premium Home Luxury Desk</title>
    
    <!-- Google Fonts (Cinzel और Montserrat लग्जरी लुक के लिए) -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Montserrat:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons के लिए -->
    <link rel="stylesheet" href="https://cloudflare.com">

    <style>
        /* --- ROYAL LUXURY CORE CONFIGURATION --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
            scroll-behavior: smooth;
        }
        
        h1, h2, h3, h4, .cinzel-font {
            font-family: 'Cinzel', serif;
        }

        :root {
            --royal-blue: #0a192f;       /* Deep Luxury Navy */
            --royal-gold: #d4af37;       /* Antique Metallic Gold */
            --light-gold: #fcf8e3;       /* Premium Gold Cream Accent */
            --premium-white: #ffffff;
            --elegant-grey: #f4f6f9;
            --dark-charcoal: #232b38;
            --success-gold: #c5a028;
            --luxury-shadow: 0 20px 40px rgba(10, 25, 47, 0.08);
            --transition-smooth: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        }

        body {
            background-color: var(--elegant-grey);
            color: var(--dark-charcoal);
            overflow-x: hidden;
            line-height: 1.7;
        }

        /* --- ROYAL HEADER WITH INTEGRATED LOGO --- */
        header {
            background-color: var(--royal-blue);
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 3px solid var(--royal-gold);
            box-shadow: 0 5px 25px rgba(0,0,0,0.2);
        }
        .royal-brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .brand-titles h1 {
            color: var(--premium-white);
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: 1px;
            line-height: 1;
        }
        .brand-titles h1 span {
            color: var(--royal-gold);
        }
        .brand-titles p {
            color: #8892b0;
            font-size: 0.75rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 4px;
        }
        .elite-call-anchor {
            background: linear-gradient(135deg, var(--royal-gold), #b89728);
            color: var(--royal-blue);
            padding: 14px 30px;
            border-radius: 4px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: var(--transition-smooth);
            border: 1px solid var(--royal-gold);
            box-shadow: 0 4px 15px rgba(212,175,55,0.2);
        }
        .elite-call-anchor:hover {
            background: transparent;
            color: var(--royal-gold);
            box-shadow: 0 4px 20px rgba(212,175,55,0.4);
            transform: translateY(-2px);
        }

        /* --- ELITE HERO BANNER --- */
        .royal-hero {
            background: linear-gradient(rgba(10, 25, 47, 0.92), rgba(35, 43, 56, 0.88)), url('https://unsplash.com');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--premium-white);
            text-align: center;
            padding: 140px 20px 160px 20px;
            position: relative;
        }
        .royal-hero h2 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 25px;
            letter-spacing: 1px;
            color: var(--premium-white);
        }
        .royal-hero h2 span {
            color: var(--royal-gold);
        }
        .royal-hero p {
            font-size: 1.35rem;
            margin-bottom: 45px;
            color: #a8b2d1;
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
            font-weight: 300;
        }
        .royal-cta-trigger {
            background: transparent;
            color: var(--royal-gold);
            font-size: 1.1rem;
            padding: 18px 50px;
            border: 2px solid var(--royal-gold);
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: var(--transition-smooth);
            text-decoration: none;
            display: inline-block;
        }
        .royal-cta-trigger:hover {
            background-color: var(--royal-gold);
            color: var(--royal-blue);
            box-shadow: 0 0 30px rgba(212,175,55,0.4);
            transform: scale(1.03);
        }

        /* --- PRESTIGE TRUST PILLARS --- */
        .prestige-container {
            max-width: 1200px;
            margin: -50px auto 80px auto;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            padding: 0 20px;
            position: relative;
            z-index: 10;
        }
        .prestige-card {
            background-color: var(--royal-blue);
            color: var(--premium-white);
            padding: 40px 30px;
            border-radius: 4px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0,0,0,0.15);
            border: 1px solid rgba(212,175,55,0.2);
            transition: var(--transition-smooth);
        }
        .prestige-card:hover {
            transform: translateY(-5px);
            border-color: var(--royal-gold);
        }
        .prestige-card i {
            font-size: 2.5rem;
            color: var(--royal-gold);
            margin-bottom: 20px;
        }
        .prestige-card h4 {
            font-size: 1.3rem;
            margin-bottom: 10px;
            letter-spacing: 0.5px;
        }

        /* --- LUXURY SERVICES DESIGN --- */
        .luxury-services-wrapper {
            max-width: 1200px;
            margin: 0 auto 100px auto;
            padding: 0 20px;
            text-align: center;
        }
        .royal-heading {
            font-size: 2.8rem;
            color: var(--royal-blue);
            margin-bottom: 15px;
            font-weight: 800;
        }
        .royal-heading span {
            color: var(--royal-gold);
        }
        .luxury-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 35px;
        }
        .luxury-service-card {
            background-color: var(--premium-white);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: var(--luxury-shadow);
            transition: var(--transition-smooth);
            display: flex;
            flex-direction: column;
            text-align: left;
        }
        .luxury-service-card:hover {
            transform: translateY(-12px);
            border-color: var(--royal-gold);
            box-shadow: 0 25px 50px rgba(10,25,47,0.15);
        }
        .luxury-graphic-box {
            height: 200px;
            background-color: var(--royal-blue);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 4.5rem;
            color: var(--royal-gold);
            border-bottom: 3px solid var(--royal-gold);
        }
        .luxury-body-content {
            padding: 30px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }
        .luxury-body-content h3 {
            font-size: 1.4rem;
            margin-bottom: 12px;
            color: var(--royal-blue);
        }
        .luxury-action-trigger {
            background-color: var(--royal-blue);
            color: var(--royal-gold);
            border: 1px solid var(--royal-gold);
            padding: 15px;
            text-decoration: none;
            font-weight: bold;
            text-align: center;
            text-transform: uppercase;
            transition: var(--transition-smooth);
        }
        .luxury-service-card:hover .luxury-action-trigger {
            background-color: var(--royal-gold);
            color: var(--royal-blue);
        }

        /* --- BOOKING PANEL (जो अधूरा था) --- */
        .royal-booking-panel {
            background-color: var(--royal-blue);
            color: var(--premium-white);
            padding: 60px 20px;
            text-align: center;
            border-top: 3px solid var(--royal-gold);
        }
        
        /* Floating WhatsApp Button */
        .whatsapp-float {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background-color: #25d366;
            color: white;
            width: 60px;
            height: 60px;
            border-radius: 50px;
            text-align: center;
            font-size: 30px;
            box-shadow: 2px 2px 3px #999;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="royal-brand">
            <div class="brand-titles">
                <h1>KVA <span>Ghar Seva</span></h1>
